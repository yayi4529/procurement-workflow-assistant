PROCUREMENT_ENVIRONMENT=development
PROCUREMENT_SERVICE_NAME=procurement-workflow-assistant
PROCUREMENT_BACKEND_BASE_URL=http://127.0.0.1:8000
PROCUREMENT_BACKEND_REQUEST_TIMEOUT_SECONDS=10
PROCUREMENT_IDENTITY_GATEWAY_SECRET=
PROCUREMENT_ALLOW_TEST_PLATFORM=true
PROCUREMENT_LLM_ENABLED=false
PROCUREMENT_FAULT_GUIDANCE_ENABLED=false
FAULT_KNOWLEDGE_PATH=knowledge/fault-guidance
FAULT_STATE_TTL_SECONDS=86400
# Qwen (DashScope OpenAI-compatible endpoint)
PROCUREMENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PROCUREMENT_LLM_API_KEY=
PROCUREMENT_LLM_MODEL=qwen-plus
PROCUREMENT_LLM_TIMEOUT_SECONDS=30
PROCUREMENT_LLM_MAX_TOOL_STEPS=6
PROCUREMENT_LLM_MAX_TOTAL_TOOL_CALLS=24
PROCUREMENT_LLM_MAX_HISTORY_MESSAGES=20
PROCUREMENT_LLM_MAX_TOOL_RESULT_CHARS=20000
LLM_CONTEXT_KNOWLEDGE_PATH=docs/rag-context-fault-guidance.md
PROCUREMENT_LLM_ROLE_SKILLS_PATH=skills
PROCUREMENT_LLM_SKILL_ROUTING_MODE=strict

# Governed procurement analytics is hosted by backend 8001. The Agent never receives DB credentials.
PROCUREMENT_FEISHU_ENABLED=false
PROCUREMENT_FEISHU_APP_ID=
PROCUREMENT_FEISHU_APP_SECRET=
PROCUREMENT_FEISHU_VERIFICATION_TOKEN=
PROCUREMENT_FEISHU_ENCRYPT_KEY=
PROCUREMENT_FEISHU_WEBHOOK_PATH=/webhooks/feishu
PROCUREMENT_NOTIFICATION_GATEWAY_ENABLED=false
PROCUREMENT_NOTIFICATION_GATEWAY_PATH=/internal/notifications
PROCUREMENT_NOTIFICATION_GATEWAY_TOKEN=
PROCUREMENT_NOTIFICATION_DELIVERY_STORE_BACKEND=memory
